<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <!-- Estructura del diseño -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado: título + BTN Salir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/titulo_main"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold"/>

            <!-- BTN Cerrar Sesión -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_salir"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/gris"/>
        </LinearLayout>

        <!-- Usuario conectado -->
        <TextView
            android:id="@+id/tvUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_pequeno"
            android:layout_marginBottom="8dp"
            tools:text="Conectado como: correo@ejemplo.cl"/>

        <!-- Formulario del Gasto -->
        <EditText
            android:id="@+id/etGastoId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_id"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_descripcion"
            android:inputType="textCapSentences"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <EditText
                android:id="@+id/etMonto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="@string/hint_monto"
                android:inputType="number"
                android:maxLength="9"
                android:layout_marginEnd="4dp"/>

            <!-- Fecha: al tocarla se abre un calendario -->
            <EditText
                android:id="@+id/etFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:focusable="false"
                android:hint="@string/hint_fecha"
                android:inputType="none"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Spinners: Categoría y Método de pago -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="8dp">

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:layout_marginEnd="4dp"/>

            <Spinner
                android:id="@+id/spMetodoPago"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- BTN Guardar y Buscar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCreate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/btn_guardar"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_500"
                android:layout_marginEnd="4dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/btn_buscar"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/verde"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- BTN Actualizar y Eliminar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginTop="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/btn_actualizar"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/naranjo"
                android:layout_marginEnd="4dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/btn_eliminar"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/rojo"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Total gastado -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:background="@color/fondo_total"
            android:textColor="@color/black"
            android:textSize="@dimen/texto_normal"
            android:textStyle="bold"
            tools:text="Total gastado: $45.990 (5 registros)"/>

        <!-- Lista de gastos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/titulo_lista"
            android:textSize="@dimen/texto_pequeno"
            android:textStyle="bold"/>

        <ListView
            android:id="@+id/lvGastos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    </LinearLayout>

</LinearLayout>
